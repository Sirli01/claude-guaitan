[sub_resource type="Shader" id="shader_beam"]
code = "
shader_type canvas_item;
void fragment() {
	float edge = 1.0 - 2.0 * abs(UV.x - 0.5);
	edge = smoothstep(0.0, 0.7, edge);
	float vert = 1.0 - UV.y * 0.6;
	float a = edge * vert * 0.10;
	COLOR = vec4(1.0, 0.92, 0.65, a);
}
"

[sub_resource type="ShaderMaterial" id="mat_beam"]
shader = SubResource("shader_beam")

[sub_resource type="Shader" id="shader_core"]
code = "
shader_type canvas_item;
void fragment() {
	float edge = 1.0 - 2.0 * abs(UV.x - 0.5);
	edge = smoothstep(0.0, 0.8, edge);
	float vert = 1.0 - UV.y * 0.5;
	float a = edge * vert * 0.07;
	COLOR = vec4(1.0, 0.95, 0.7, a);
}
"

[sub_resource type="ShaderMaterial" id="mat_core"]
