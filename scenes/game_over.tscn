[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_over.gd" id="1_go"]

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;
void fragment() {
	vec2 uv = UV - vec2(0.5);
	float dist = length(uv) * 2.0;
	float vignette = smoothstep(0.2, 1.0, dist);
	COLOR = vec4(0.15, 0.0, 0.05, vignette * 0.85);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")

